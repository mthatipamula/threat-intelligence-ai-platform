#!/usr/bin/env bash
# Runs the platform's CLI from source: ./tip --help
# Works whether or not uv is on PATH (it is often installed in ~/.local/bin, which shells don't always include).
set -euo pipefail
cd "$(dirname "$0")"
export PYTHONPATH="$PWD/src${PYTHONPATH:+:$PYTHONPATH}"
for uv in "$(command -v uv 2>/dev/null || true)" "$HOME/.local/bin/uv" "$HOME/.cargo/bin/uv" /opt/homebrew/bin/uv; do
  if [[ -n "$uv" && -x "$uv" ]]; then exec "$uv" run --quiet python -m tip "$@"; fi
done
if [[ -x .venv/bin/python ]]; then exec .venv/bin/python -m tip "$@"; fi
echo "uv not found. Install it (https://docs.astral.sh/uv/) or run: export PATH=\"\$HOME/.local/bin:\$PATH\"" >&2
exit 1
