# Copy with ./scripts/init-env.sh (generates the password); never commit .env.
POSTGRES_PASSWORD=
# DATABASE_URL overrides the local default (postgresql://tip:<POSTGRES_PASSWORD>@localhost:5433/tip).
DATABASE_URL=

# Optional: free abuse.ch key (https://auth.abuse.ch) enables the ThreatFox collector.
ABUSECH_AUTH_KEY=

# Optional: enables live (Claude) investigations. Without it, investigations run in free mock mode.
ANTHROPIC_API_KEY=

# Brand domains to watch for lookalikes (comma separated).
WATCH_DOMAINS=coinbase.com

# Optional MISP stack (docker compose --profile misp up -d); ./scripts/init-env.sh fills these in.
MISP_URL=https://localhost:8443
MISP_ADMIN_EMAIL=admin@meridianx.test
MISP_ADMIN_KEY=
MISP_ADMIN_PASSWORD=
MISP_DB_PASSWORD=
MISP_DB_ROOT_PASSWORD=
MISP_REDIS_PASSWORD=
# The local MISP uses a self-signed certificate; set true for a MISP with a real certificate.
MISP_VERIFY_TLS=false
